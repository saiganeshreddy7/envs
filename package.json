{
  "name": "env-manager",
  "displayName": "Environment Variables Manager",
  "description": "Manage system environment variables directly within VSCode",
  "repository": {
    "type": "git",
    "url": "https://github.com/saiganeshreddy7/envs.git"
  },
  "version": "0.0.1",
  "publisher": "saiganeshreddy",
  "icon": "images/icon.png",
  "engines": {
    "vscode": "^1.98.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:envManager.openView"
  ],
  "main": "./out/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "envManager.openConfig",
                "title": "envs"
            },
            {
                "command": "envManager.updateVariable",
                "title": "Update Environment Variable"
            }
        ]
    },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/glob": "^7.1.3",
    "@types/mocha": "^9.0.0",
    "@types/node": "14.x",
    "@types/vscode": "^1.98.0",
    "eslint": "^7.32.0",
    "glob": "^7.1.7",
    "mocha": "^9.0.0",
    "typescript": "^4.4.3",
    "vscode-test": "^1.5.2"
  }
}
